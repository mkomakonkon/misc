;***  CMU-800 PLAYER Ver 0.3B  ***
;***  EQU PACK  ***
;***  82/07/25  ***
;***  by  ANOM  ***
LETNL EQU 0A2EH
NL    EQU 0A29H
PRNTS EQU 08C4H  ;PRINT " "
PRNT  EQU 08C6H  ;PRINT CHAR$(A)
MSG   EQU 0889H  ;PRINT (DE)→0DH
MSGX  EQU 087BH  ;PRINT (DE)→0DH
BELL  EQU 0F14H
MELDY EQU 0F3FH  ;MUSIC (DE)→0DH or "*"
SOUT  EQU 0F22H  ;BC←long HL←high
CHR80 EQU 0C7CH  ;CONSOLEC80
CHR40 EQU 0CEEH  ;CONSOLEC40
SCRSET EQU 08D3H
GETL  EQU 06A4H  ;INPUT (DE)
GETKEY EQU 0832H  ;GET A
KBSET EQU 0571H
PRNTT EQU 086CH  ;PRINT TAB
PRTHL EQU 05D8H  ;HLreg PRINT
PRTHX EQU 05DDH  ;Areg PRINT
ASC   EQU 05F3H  ;Areg+4 → ASC!
HEX   EQU 05FDH  ;ASC → Areg+4
HLHEX EQU 0614H  ;(DE)→HL
AHEX  EQU 0623H  ;(DE)→A
XTEMP EQU 0E56H  ;A→TEMPO
TIMST EQU 0E5EH  ;DE→Sec.
TIMRD EQU 0EA9H  ;DE←Sec.
BRKEY EQU 0562H  ;Break→Z=1
POINT EQU 0C29H  ;HL←CURSOR
SAME  EQU 063AH  ;(DE)=(HL)?
SAVE1 EQU 0251H
SAVE2 EQU 0282H
MLOAD EQU 01CBH  ;モニタのLコマンド
LOAD1 EQU 028EH
LOAD2 EQU 02B2H
VELY  EQU 02BEH
CMTON EQU 0457H  ;D(BIT 0or1)=1 THEN Write
CMTOFF EQU 04CEH
SCROL EQU 0AA7H  ;SCROOL UP!
NLMSGX EQU 05B6H
NLPHLS EQU 05BCH
KIN   EQU 058CH  ;A←Head 05CC=Break jump
MON   EQU 00B1H
