RM2790:DEFB 0F3H,17H,00H,02H    ;17F3H参照、ソースが変わるとここの値を変える必要がある。（一度アセンブルしないと修正できない…）
								;WICSで作成したルーチンなので、適正化したい
								;00H,01Hを17F3に格納し、そのアドレスを17F1に格納しているが、
								;変数のアドレスをいちいち書くのはおかしいので整理が必要
								;この変数はどのGRAMを表示しているか示している。


MEM2GRAM:CALL	GRAMON
        LD      A,01H   ;GRAPHI1
        OUT     (0F7H),A
        LD      HL,2000H        ;from
        LD      DE,0C000H       ;to
        LD      BC,3FFFH
        LDIR    
        LD      A,02H   ;GRAPHI2
        OUT     (0F7H),A
        LD      HL,6000H        ;from
        LD      DE,0C000H       ;to
        LD      BC,3FFFH
        LDIR    
        CALL	GRAMOFF

;GRAMとアドレスが被るデータの移動
        LD      HL,A000H        ;from
        LD      DE,06000H       ;to
        LD      BC,3FFFH
        LDIR    

		CALL	GRAMON
        LD      A,03H   ;GRAPHI3
        OUT     (0F7H),A
        LD      HL,6000H        ;from
        LD      DE,0C000H       ;to
        LD      BC,3FFFH
        LDIR    
        CALL	GRAMOFF
        
        LD      A,0C9H  ;MEM2GRAMをC9（RET）で上書きして無効化
        LD      (MEM2GRAM),A
        RET

GRAMON: IN      A,(0E8H)
        SET     7,A		;VRAM ON
        RES     6,A		;グラフィックアクセス
        OUT     (0E8H),A
        RET
GRAMOFF:IN      A,(0E8H)
        RES     7,A		;VRAM OFF
        SET     6,A		;キャラクタアクセス
        OUT     (0E8H),A
        RET

