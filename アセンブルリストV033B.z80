  START EQU 012A0H
  ORG START
        CALL    MEM2GRAM
        LD      SP,337AH
        LD      HL,337AH        ;PLAYER専用
        LD      (HL),0FDH       ;PLAYER専用ֳ
        CALL    CHR40
        CALL    CMUSET0
        CALL    DTanalysis
HSTART: LD      HL,DSPDT
        CALL    CSRPRT
        LD      A,0FFH   ;(未確認だが残す)
HSTART2:AND     A       ;(未確認だが残す)
        JR      Z,HSTART
        CALL    INPUT
        CP      50H     ;P:PLAY
        CALL    Z,PLAY
        CP      4CH     ;L:LOAD
        CALL    Z,MLOAD
        CP      4DH     ;M:MON
        CALL    Z,MON
        JP      HSTART2 ;LOOP
DSPDT:  DEFB    00H,00H ;CURSOR0,0
        DEFB    06H
        DB    '*** CMU-800 PLAYER Ver 0.33B ***'

        DEFB    0DH
        DEFB    0DH
        DB    'P:PLAY'

        DEFB    0DH
        DB    'Q:STOP'

        DEFB    0DH
        DB    'L:LOAD'

        DEFB    0DH
        DB    'M:MON'

        DEFB    0DH
        DEFB    0DH
        DB    '?'
        DEFB    00H
DTanalysis: LD      DE,337DH
        LD      HL,32E2H
        LD      B,0BH
        JR      RM1B94
RM1B8B: LD      A,(DE)
        INC     DE
        INC     DE
        INC     DE
        CP      0FEH
        JP      C,RM1B8B
RM1B94: LD      (HL),E
        INC     HL
        LD      (HL),D
        INC     HL
        DJNZ    RM1B8B
        LD      HL,(3231H)
        LD      DE,(32F6H)
        AND     A
        SBC     HL,DE
        CALL    RM1EDA
        LD      (3233H),BC
        LD      HL,(322FH)
        AND     A
        SBC     HL,BC
        LD      BC,000AH
        SBC     HL,BC
        LD      (3235H),HL
        CALL    SETSTRT
        LD      A,01H
        LD      (32DBH),A
        LD      HL,0001H
        LD      (32DCH),HL
        LD      (32DEH),HL
        LD      A,00H
        LD      (3229H),A
        LD      HL,(32E4H)
        LD      (32E0H),HL
        XOR     A
        LD      (322DH),A
        LD      (3226H),A
        LD      (3227H),A
        RET
RM1EDA: LD      DE,0003H
        LD      BC,0FFFFH
RM1EE0: INC     BC
        SBC     HL,DE
        JP      NC,RM1EE0
        RET
PLAY:   CALL    SETSTRT
        CALL    S8235N1
LOOP1:  LD      B,09H
        LD      HL,323EH        ;(ֳ要確認)
LOOP2:  DEC     (HL)
        CALL    Z,RM2886        ;(ֳ要確認)
        INC     HL
        DEC     (HL)
        CALL    Z,RM297D        ;(ֳ要確認)
        LD      DE,0010H
        ADD     HL,DE
        DJNZ    LOOP2
        LD      A,(3237H)
        CP      0FFH
        JR      NZ,POINT1
        LD      A,(3238H)
        AND     A
        JP      NZ,ENDPLAY
POINT1: CALL    TIMING
CALL BOCHI
        CALL    ONKAI
        JP      LOOP1
ENDPLAY:CALL    S8235N0
        XOR     A
        RET
